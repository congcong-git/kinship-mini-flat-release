page {
  background: #faf7f2;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.wrap { padding: 24rpx 28rpx 60rpx; }

/* 顶部 */
.hero { padding: 24rpx 4rpx 36rpx; }
.hero-title {
  font-size: 64rpx; font-weight: 700; color: #2c2a26;
  letter-spacing: 2rpx; line-height: 1.2;
}
.hero-sub { margin-top: 18rpx; font-size: 26rpx; color: #8a837a; letter-spacing: .4rpx; }
.hero-rule { margin-top: 28rpx; width: 71rpx; height: 6rpx; background: #c9a227; border-radius: 4rpx; }
.hero-chips { display: flex; gap: 12rpx; margin-top: 28rpx; }
.hero-chip {
  font-size: 21rpx; color: #96702a; background: #fbf3dd;
  border: 2rpx solid #eddcb0; border-radius: 999rpx; padding: 6rpx 18rpx;
}

/* A / B 切换 */
.who-row { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.who-tab {
  flex: 1; background: #fff; border: 2rpx solid #e8e0d4; border-radius: 16rpx;
  padding: 20rpx 12rpx; text-align: center;
}
.who-tab.on { background: #c9a227; border-color: #c9a227; }
.who-tab.on .who-t, .who-tab.on .who-v { color: #fff; }
.who-t { font-size: 23rpx; color: #a09889; }
.who-v { margin-top: 8rpx; font-size: 32rpx; font-weight: 600; color: #2c2a26; }

/* 卡片 */
.card {
  background: #fff; border-radius: 20rpx; padding: 26rpx 24rpx;
  margin-bottom: 20rpx; border: 2rpx solid #eee7db;
}
.card-title { font-size: 23rpx; color: #a09889; margin-bottom: 16rpx; }

/* 关系链 */
.chain { display: flex; flex-wrap: wrap; align-items: center; margin-bottom: 16rpx; }
.chain-node {
  background: #f5f0e6; color: #6f675c; font-size: 23rpx;
  padding: 8rpx 18rpx; border-radius: 100rpx; margin: 4rpx 0;
}
.chain-node.now { background: #c9a227; color: #fff; }
.chain-arrow { color: #c9bfab; font-size: 22rpx; margin: 0 6rpx; }

/* 当前称谓 */
.now { background: #fffdf6; border: 2rpx solid #c9a227; border-radius: 14rpx; padding: 20rpx; margin-bottom: 8rpx; }
.now-desc { font-size: 23rpx; color: #8a837a; }
.now-main { font-size: 46rpx; font-weight: 600; color: #b8860b; margin-top: 6rpx; }
.now-alts { font-size: 23rpx; color: #8a837a; margin-top: 8rpx; }
/* 长幼分支：跟主称是两个不同的人，用左侧竖线与同义称谓分开 */
.now-age {
  font-size: 24rpx; color: #96702a; margin-top: 10rpx; line-height: 1.5;
  padding-left: 12rpx; border-left: 4rpx solid #d9b96a;
}

.tip { color: #a09889; font-size: 26rpx; text-align: center; padding: 20rpx 0; }

/* 步骤按钮 */
.steps { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 8rpx; }
.step {
  background: #fff; border: 2rpx solid #e8e0d4; border-radius: 12rpx;
  padding: 14rpx 22rpx;
}
.step-l { font-size: 28rpx; color: #2c2a26; }
.step-h { font-size: 21rpx; color: #a09889; margin-top: 4rpx; }

.undo { margin-top: 18rpx; font-size: 25rpx; color: #a09889; text-decoration: underline; }
.link-row { display: flex; flex-direction: row; align-items: center; }
.sex-row { display: flex; flex-direction: row; align-items: center; margin-bottom: 24rpx; }
.sex-label { font-size: 25rpx; color: #a09889; margin-right: 16rpx; }
.sex-opt {
  padding: 12rpx 34rpx; border-radius: 999rpx; font-size: 25rpx;
  margin-right: 14rpx; background: #fff; border: 2rpx solid #e8e0d4; color: #6f675c;
}
.sex-opt.on { background: #c9a227; border-color: #c9a227; color: #fff; }

/* 示例 */
.ex-row { display: flex; flex-wrap: wrap; gap: 14rpx; }
.ex { background: #fff; border: 2rpx solid #e8e0d4; border-radius: 12rpx; padding: 14rpx 20rpx; }
.ex-l { font-size: 26rpx; color: #2c2a26; }
.ex-n { font-size: 21rpx; color: #a09889; margin-top: 4rpx; }

/* 结果 */
.relation-badge {
  display: inline-block; background: #c9a227; color: #fff;
  font-size: 23rpx; padding: 8rpx 20rpx; border-radius: 100rpx; margin-bottom: 8rpx;
}
.answer { display: flex; gap: 16rpx; padding: 20rpx 0; align-items: flex-start; }
.answer + .answer { border-top: 2rpx dashed #f0e9dd; }
.answer-who { flex-shrink: 0; width: 190rpx; }
.answer-name { font-size: 28rpx; font-weight: 500; color: #2c2a26; }
.answer-desc { font-size: 20rpx; color: #b5ada0; margin-top: 4rpx; line-height: 1.35; }
.answer-arrow { font-size: 22rpx; color: #b5ada0; margin-top: 6rpx; }
.answer-main { flex: 1; font-size: 42rpx; font-weight: 600; color: #b8860b; line-height: 1.3; }
.answer-alts { flex: 1.3; padding-top: 6rpx; }
.answer-alts-line {
  font-size: 24rpx; color: #8a837a; margin-top: 10rpx; line-height: 1.6;
}
/* 长幼分支：条件成立时才是这个叫法，与「其他称呼」不是一回事 */
.answer-age-line {
  font-size: 23rpx; color: #96702a; margin-top: 10rpx; line-height: 1.6;
  padding-left: 12rpx; border-left: 4rpx solid #d9b96a;
}
.alt-tag {
  display: inline-block; background: #f5f0e6; color: #7a7266;
  font-size: 23rpx; padding: 8rpx 18rpx; border-radius: 100rpx;
  margin: 0 12rpx 12rpx 0;
}

/* 说明 */
.note-item {
  font-size: 25rpx; color: #6f675c; line-height: 1.75;
  margin-bottom: 12rpx; padding-left: 26rpx; position: relative;
}
.note-item::before {
  content: ''; position: absolute; left: 6rpx; top: 16rpx;
  width: 8rpx; height: 8rpx; border-radius: 50%; background: #d9c48f;
}
/* 称谓小注：这个字从哪来 */
.cite { margin-top: 18rpx; padding-top: 16rpx; border-top: 1px solid #f0e9dd; }
.cite-head { font-size: 24rpx; font-weight: 500; color: #96702a; letter-spacing: .3rpx; }
.cite-quote {
  margin-top: 12rpx; padding-left: 16rpx; border-left: 4rpx solid #e3cf92;
  font-size: 25rpx; color: #4a453e; line-height: 1.75;
}
.cite-src { display: block; margin-top: 5rpx; font-size: 21rpx; color: #a09889; }
.cite-gloss { margin-top: 12rpx; font-size: 24rpx; color: #6f675c; line-height: 1.75; }
.note-tail { margin-top: 16rpx; }

/* 按钮 */
.btn-row { display: flex; gap: 16rpx; margin-top: 8rpx; }
.btn {
  flex: 1; text-align: center; background: #fff; border: 2rpx solid #e8e0d4;
  border-radius: 100rpx; padding: 18rpx; font-size: 26rpx; color: #6f675c;
}
